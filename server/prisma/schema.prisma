generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums (values from project-scope.md) ───────────────────────────────────

enum Role {
  ADMIN // Deployed with the system. Creates and manages agents.
  AGENT // Created by an admin. Views and manages tickets.
}

enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum TicketCategory {
  GENERAL_QUESTION
  TECHNICAL_QUESTION
  REFUND_REQUEST
}

// Who wrote a message in a ticket's thread.
enum MessageSender {
  CUSTOMER // Inbound email from the student
  AGENT // Reply written by a support agent
  AI // Automatic reply generated by the AI
}

// ─── Users and authentication ───────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(AGENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTickets Ticket[]
  messages        Message[]

  @@map("users")
}

// Database-backed sessions for express-session.
// Field names follow the format @quixo3/prisma-session-store expects.
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@index([expiresAt])
  @@map("sessions")
}

// ─── Tickets ────────────────────────────────────────────────────────────────

model Ticket {
  id            Int             @id @default(autoincrement())
  subject       String
  customerEmail String
  customerName  String?
  status        TicketStatus    @default(OPEN)
  // Null until the AI (or an agent) classifies the ticket.
  category      TicketCategory?
  // AI-generated summary of the ticket thread.
  aiSummary     String?
  assignedToId  Int?
  assignedTo    User?           @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messages Message[]

  @@index([status])
  @@index([category])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([customerEmail])
  @@map("tickets")
}

// One email or reply in a ticket's thread.
model Message {
  id             Int           @id @default(autoincrement())
  ticketId       Int
  ticket         Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender         MessageSender
  // Set when sender is AGENT. Kept as null if that user is later deleted.
  authorId       Int?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body           String
  // Email Message-ID header, used to link replies to the right ticket.
  emailMessageId String?       @unique
  createdAt      DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("messages")
}

// ─── Knowledge base ─────────────────────────────────────────────────────────

// Articles the AI uses to write answers.
model KnowledgeBaseArticle {
  id        Int             @id @default(autoincrement())
  title     String
  content   String
  // Optional: limits the article to one ticket category.
  category  TicketCategory?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("knowledge_base_articles")
}
